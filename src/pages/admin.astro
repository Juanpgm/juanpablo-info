---
// Private metrics view — Vercel Web Analytics behind HTTP Basic Auth. No
// session/cookie logic: the browser's native basic-auth prompt IS the login
// form, and re-checks credentials on every request (ADMIN_USER/ADMIN_PASSWORD
// env vars). Not under [locale] on purpose — this is a tool for the site
// owner, not public content, so it doesn't need i18n routing.
export const prerender = false;

import { neon } from '@neondatabase/serverless';
import { REPLY_SUBJECT } from '../lib/contact-email';
import { isAuthorized } from '../lib/admin-auth';

// The lead follow-up toggle's mutating POST handler lives at
// `pages/api/admin-leads.ts` (a real, routed endpoint) — NOT exported from
// this file. Astro only routes HTTP method handlers from files under
// `src/pages/**/*.ts`; a `.astro` page's own `export const POST` is never
// invoked (verified against the build manifest — a page route only ever
// renders its component). The leads table's `<form>` below posts there.

const authorized = isAuthorized(Astro.request);
if (!authorized) {
  Astro.response.status = 401;
  Astro.response.headers.set('WWW-Authenticate', 'Basic realm="Admin"');
}

// Project/team IDs aren't secret (they're already committed in
// .vercel/project.json) — only the access token is, so it's the only
// required env var beyond the admin credentials.
const PROJECT_ID = process.env.VERCEL_PROJECT_ID ?? 'prj_4NkCROVegmGYERGATxsRW4Ut6Ujp';
const TEAM_ID = process.env.VERCEL_TEAM_ID ?? 'team_SzZM9UUotBq10Z80gIsZpAzv';
const VERCEL_TOKEN = process.env.VERCEL_API_TOKEN;

interface CountResult {
  data?: { total?: number; visitors?: number };
}
interface AggregateRow {
  [key: string]: string | number;
}
interface AggregateResult {
  data?: AggregateRow[];
}

async function queryAnalytics<T>(path: string, params: Record<string, string>): Promise<T> {
  const url = new URL(`https://api.vercel.com/v1/query/web-analytics/${path}`);
  url.searchParams.set('teamId', TEAM_ID);
  url.searchParams.set('projectId', PROJECT_ID);
  for (const [key, value] of Object.entries(params)) url.searchParams.set(key, value);

  const res = await fetch(url, { headers: { Authorization: `Bearer ${VERCEL_TOKEN}` } });
  if (!res.ok) throw new Error(`${path} → ${res.status} ${await res.text()}`);
  return res.json();
}

let totals: CountResult['data'] | null = null;
let topPages: AggregateRow[] | null = null;
let topReferrers: AggregateRow[] | null = null;
let topCountries: AggregateRow[] | null = null;
let fetchError: string | null = null;

if (authorized) {
  if (!VERCEL_TOKEN) {
    fetchError = 'Falta VERCEL_API_TOKEN en las variables de entorno.';
  } else {
    const now = Date.now();
    const since = String(now - 30 * 24 * 60 * 60 * 1000);
    const until = String(now);

    const [totalsRes, pagesRes, referrersRes, countriesRes] = await Promise.allSettled([
      queryAnalytics<CountResult>('visits/count', {}),
      queryAnalytics<AggregateResult>('visits/aggregate', { since, until, by: 'requestPath', limit: '10' }),
      queryAnalytics<AggregateResult>('visits/aggregate', { since, until, by: 'referrerHostname', limit: '10' }),
      queryAnalytics<AggregateResult>('visits/aggregate', { since, until, by: 'country', limit: '10' }),
    ]);

    if (totalsRes.status === 'fulfilled') totals = totalsRes.value.data;
    if (pagesRes.status === 'fulfilled') topPages = pagesRes.value.data ?? [];
    if (referrersRes.status === 'fulfilled') topReferrers = referrersRes.value.data ?? [];
    if (countriesRes.status === 'fulfilled') topCountries = countriesRes.value.data ?? [];

    const failed = [totalsRes, pagesRes, referrersRes, countriesRes].find((r) => r.status === 'rejected');
    if (failed && failed.status === 'rejected') {
      fetchError = `Vercel Analytics API falló: ${failed.reason?.message ?? failed.reason}`;
    }
  }
}

interface LeadRow {
  id: number;
  name: string;
  email: string;
  message: string;
  locale: string;
  attachment_urls: string[] | null;
  created_at: string;
  contacted_at: string | null;
}
interface LeadCountRow {
  count: number;
}

let leads: LeadRow[] | null = null;
let leadsCount30d: number | null = null;
let unattendedCount: number | null = null;
let leadsError: string | null = null;

// Per-request instantiation (never module top-level), same reasoning as
// pages/api/contact.ts: a missing DATABASE_URL must never crash prerendering
// of any other static page at build time.
if (authorized) {
  if (!process.env.DATABASE_URL) {
    leadsError = 'DATABASE_URL is not set — leads cannot be loaded.';
  } else {
    const sql = neon(process.env.DATABASE_URL);
    const [leadsRes, countRes, unattendedRes] = await Promise.allSettled([
      sql`SELECT id, name, email, message, locale, attachment_urls, created_at, contacted_at FROM contact_submissions ORDER BY created_at DESC LIMIT 50`,
      sql`SELECT count(*)::int AS count FROM contact_submissions WHERE created_at >= now() - interval '30 days'`,
      sql`SELECT count(*)::int AS count FROM contact_submissions WHERE contacted_at IS NULL`,
    ]);

    if (leadsRes.status === 'fulfilled') leads = leadsRes.value as unknown as LeadRow[];
    if (countRes.status === 'fulfilled') {
      const rows = countRes.value as unknown as LeadCountRow[];
      leadsCount30d = rows[0]?.count ?? 0;
    }
    if (unattendedRes.status === 'fulfilled') {
      const rows = unattendedRes.value as unknown as LeadCountRow[];
      unattendedCount = rows[0]?.count ?? 0;
    }

    // Named per query (not a bare "Leads query failed") so a failure in just
    // the unattended-count query doesn't get misreported as the leads table
    // itself having failed while it actually loaded fine.
    const namedQueries: [string, PromiseSettledResult<unknown>][] = [
      ['leads', leadsRes],
      ['30-day count', countRes],
      ['unattended count', unattendedRes],
    ];
    const failedLeadsQuery = namedQueries.find(([, r]) => r.status === 'rejected');
    if (failedLeadsQuery) {
      const [label, result] = failedLeadsQuery;
      const reason = result.status === 'rejected' ? result.reason : undefined;
      leadsError = `Leads query (${label}) failed: ${reason?.message ?? reason}`;
    }
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — Métricas</title>
    <style>
      body {
        margin: 0;
        padding: 2rem 1.5rem 4rem;
        font-family: system-ui, sans-serif;
        background: #0f1115;
        color: #e6e6e6;
      }
      main { max-width: 960px; margin: 0 auto; }
      h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
      .subtitle { color: #9a9a9a; margin-bottom: 2rem; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
      .card { background: #1a1d24; border: 1px solid #2a2e38; border-radius: 10px; padding: 1.25rem; }
      .card .value { font-size: 2rem; font-weight: 700; }
      .card .label { color: #9a9a9a; font-size: 0.85rem; }
      table { width: 100%; border-collapse: collapse; margin-bottom: 2rem; }
      th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #2a2e38; }
      th { color: #9a9a9a; font-weight: 500; font-size: 0.85rem; }
      section h2 { font-size: 1.1rem; margin-bottom: 0.75rem; }
      .error { color: #ff8080; background: #2a1616; border: 1px solid #4a2424; border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; }
      .empty { color: #6a6a6a; font-style: italic; }
      .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.8rem; }
      .badge--new { color: #ffb84d; background: #2a2116; border: 1px solid #4a3a24; }
      .badge--contacted { color: #7fd68a; background: #16261a; border: 1px solid #244a2c; }
      .status-form { margin-top: 0.35rem; }
      .status-form button {
        font: inherit;
        font-size: 0.8rem;
        color: #e6e6e6;
        background: #24272f;
        border: 1px solid #3a3e48;
        border-radius: 6px;
        padding: 0.2rem 0.5rem;
        cursor: pointer;
      }
      .status-form button:hover { background: #2a2e38; }
    </style>
  </head>
  <body>
    <main>
      <h1>Métricas del sitio</h1>
      <p class="subtitle">Últimos 30 días — Vercel Web Analytics</p>

      {fetchError && <p class="error">{fetchError}</p>}

      {(totals || leadsCount30d !== null || unattendedCount !== null) && (
        <div class="grid">
          {totals && (
            <>
              <div class="card">
                <div class="value">{totals.total ?? '—'}</div>
                <div class="label">Pageviews</div>
              </div>
              <div class="card">
                <div class="value">{totals.visitors ?? '—'}</div>
                <div class="label">Visitantes únicos</div>
              </div>
            </>
          )}
          {leadsCount30d !== null && (
            <div class="card">
              <div class="value">{leadsCount30d}</div>
              <div class="label">Leads (30d)</div>
            </div>
          )}
          {unattendedCount !== null && (
            <div class="card">
              <div class="value">{unattendedCount}</div>
              <div class="label">Unattended</div>
            </div>
          )}
        </div>
      )}

      {topPages && (
        <section>
          <h2>Páginas más visitadas</h2>
          {topPages.length === 0 ? (
            <p class="empty">Sin datos todavía.</p>
          ) : (
            <table>
              <thead><tr><th>Ruta</th><th>Visitas</th></tr></thead>
              <tbody>
                {topPages.map((row) => (
                  <tr><td>{row.requestPath}</td><td>{row.visitors ?? row.total ?? row.count}</td></tr>
                ))}
              </tbody>
            </table>
          )}
        </section>
      )}

      {topReferrers && (
        <section>
          <h2>Referrers</h2>
          {topReferrers.length === 0 ? (
            <p class="empty">Sin datos todavía.</p>
          ) : (
            <table>
              <thead><tr><th>Origen</th><th>Visitas</th></tr></thead>
              <tbody>
                {topReferrers.map((row) => (
                  <tr><td>{row.referrerHostname || '(directo)'}</td><td>{row.visitors ?? row.total ?? row.count}</td></tr>
                ))}
              </tbody>
            </table>
          )}
        </section>
      )}

      {topCountries && (
        <section>
          <h2>Países</h2>
          {topCountries.length === 0 ? (
            <p class="empty">Sin datos todavía.</p>
          ) : (
            <table>
              <thead><tr><th>País</th><th>Visitas</th></tr></thead>
              <tbody>
                {topCountries.map((row) => (
                  <tr><td>{row.country}</td><td>{row.visitors ?? row.total ?? row.count}</td></tr>
                ))}
              </tbody>
            </table>
          )}
        </section>
      )}

      {leadsError && <p class="error">{leadsError}</p>}

      <section id="leads">
        <h2>Leads</h2>
        {leads === null ? (
          !leadsError && <p class="empty">Unable to load leads.</p>
        ) : leads.length === 0 ? (
          <p class="empty">No leads yet.</p>
        ) : (
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Name</th>
                <th>Email</th>
                <th>Locale</th>
                <th>Status</th>
                <th>Message</th>
                <th>Attachments</th>
              </tr>
            </thead>
            <tbody>
              {leads.map((lead) => {
                const createdAtIso = new Date(lead.created_at).toISOString();
                const preview = lead.message.slice(0, 120);
                const isTruncated = lead.message.length > 120;
                const attachmentCount = lead.attachment_urls?.length ?? 0;
                const mailtoHref = `mailto:${lead.email}?subject=${encodeURIComponent(REPLY_SUBJECT)}`;
                const isContacted = lead.contacted_at !== null;
                const nextAction = isContacted ? 'unmark' : 'mark';
                const toggleLabel = isContacted ? 'Unmark' : 'Mark contacted';
                return (
                  <tr>
                    <td><time datetime={createdAtIso}>{createdAtIso}</time></td>
                    <td>{lead.name}</td>
                    <td><a href={mailtoHref}>{lead.email}</a></td>
                    <td>{lead.locale}</td>
                    <td>
                      {isContacted ? (
                        <span class="badge badge--contacted">
                          Contacted {new Date(lead.contacted_at!).toISOString().slice(0, 10)}
                        </span>
                      ) : (
                        <span class="badge badge--new">New</span>
                      )}
                      <form class="status-form" method="POST" action="/api/admin-leads">
                        <input type="hidden" name="leadId" value={lead.id} />
                        <input type="hidden" name="action" value={nextAction} />
                        <button type="submit">{toggleLabel}</button>
                      </form>
                    </td>
                    <td>
                      {preview}
                      {isTruncated ? '…' : ''}
                      <details>
                        <summary>Full message</summary>
                        <p>{lead.message}</p>
                      </details>
                    </td>
                    <td>{attachmentCount}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )}
      </section>
    </main>
  </body>
</html>
