---
// Home (proposal §4.1, site-structure spec "Home Section Order"): Hero ->
// About summary -> Skills two-worlds -> Featured experience -> Featured
// projects -> Latest posts. `data-reveal` on every major section
// (lib/scroll-reveal.ts already wired in BaseLayout). Contact is no longer a
// dedicated bottom section (post-launch fast-follow) — it's now the
// ContactModal opened from Hero's "Contactar" CTA.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
// Real profile photo — same source as the dedicated About page.
import profilePhoto from '../../assets/profile-photo.jpg';
import ExperienceCounter from '../../components/ExperienceCounter.astro';
import TwoWorlds from '../../components/TwoWorlds.astro';
import Timeline from '../../components/Timeline.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BlogCard from '../../components/BlogCard.astro';
import { t, useLocale } from '../../i18n';
import { getLocalizedEntries } from '../../lib/content-fallback';
import { projects as projectSeeds } from '../../data/projects';
import { mergeProjects } from '../../lib/github';

export function getStaticPaths() {
  return [
    { params: { locale: 'es' } },
    { params: { locale: 'en' } },
    { params: { locale: 'de' } },
    { params: { locale: 'fr' } },
    { params: { locale: 'ru' } },
  ];
}

const locale = useLocale(Astro.params.locale);

const experience = await getLocalizedEntries('experience', locale);
const featuredExperience = experience
  .filter((entry) => entry.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 4);

const featuredProjects = await mergeProjects(
  projectSeeds.filter((project) => project.featured),
  import.meta.env.GITHUB_TOKEN
);

const posts = await getLocalizedEntries('blog', locale);
const latestPosts = posts
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout title={t(locale, 'hero.title')} description={t(locale, 'hero.tagline')} jsonLd="person">
  <Hero />

  <section class="section" data-reveal aria-labelledby="about-summary-heading">
    <div class="section-header">
      <h2 id="about-summary-heading">{t(locale, 'about.heading')}</h2>
      <a href={getRelativeLocaleUrl(locale, 'about')} class="nav-link">{t(locale, 'about.readMore')} →</a>
    </div>
    <div class="about-intro-grid">
      <div class="prose">
        <p>{t(locale, 'about.summaryP1')}</p>
        <p>{t(locale, 'about.summaryP2')}</p>
      </div>
      <figure class="about-photo-frame">
        <Image src={profilePhoto} alt={t(locale, 'about.photoAlt')} width={480} height={480} />
      </figure>
    </div>
  </section>

  <TwoWorlds />

  <section class="section" data-reveal aria-labelledby="featured-experience-heading">
    <div class="section-header">
      <h2 id="featured-experience-heading">{t(locale, 'experience.featuredHeading')}</h2>
      <a href={getRelativeLocaleUrl(locale, 'experience')} class="nav-link">{t(locale, 'experience.viewAll')} →</a>
    </div>
    <ExperienceCounter />
    <Timeline entries={featuredExperience} locale={locale} />
  </section>

  <section class="section" data-reveal aria-labelledby="featured-projects-heading">
    <div class="section-header">
      <h2 id="featured-projects-heading">{t(locale, 'projects.heading')}</h2>
      <a href={getRelativeLocaleUrl(locale, 'projects')} class="nav-link">{t(locale, 'projects.viewAll')} →</a>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project, index) => <ProjectCard project={project} locale={locale} index={index} />)}
    </div>
  </section>

  <section class="section" data-reveal aria-labelledby="latest-posts-heading">
    <div class="section-header">
      <h2 id="latest-posts-heading">{t(locale, 'blog.latestHeading')}</h2>
      <a href={getRelativeLocaleUrl(locale, 'blog')} class="nav-link">{t(locale, 'blog.viewAll')} →</a>
    </div>
    <div class="blog-grid">
      {latestPosts.map((post, index) => <BlogCard entry={post} locale={locale} index={index} />)}
    </div>
  </section>
</BaseLayout>
