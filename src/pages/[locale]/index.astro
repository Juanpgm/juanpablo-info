---
// Home (proposal §4.1, site-structure spec "Home Section Order"): Hero ->
// About summary -> Skills two-worlds -> Featured experience -> Featured
// projects -> Latest posts -> Contact. `data-reveal` on every major section
// (lib/scroll-reveal.ts already wired in BaseLayout).
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
// PLACEHOLDER photo — same source as the dedicated About page (see
// src/assets/about-photo-placeholder.svg); swap both imports together once
// a real photo is supplied.
import photoPlaceholder from '../../assets/about-photo-placeholder.svg';
import ExperienceCounter from '../../components/ExperienceCounter.astro';
import TwoWorlds from '../../components/TwoWorlds.astro';
import Timeline from '../../components/Timeline.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BlogCard from '../../components/BlogCard.astro';
import { t, useLocale } from '../../i18n';
import { getLocalizedEntries } from '../../lib/content-fallback';
import { projects as projectSeeds } from '../../data/projects';
import { mergeProjects } from '../../lib/github';
import { site } from '../../data/site';
import { getWhatsAppHref } from '../../lib/whatsapp';

export function getStaticPaths() {
  return [{ params: { locale: 'es' } }, { params: { locale: 'en' } }, { params: { locale: 'de' } }];
}

const locale = useLocale(Astro.params.locale);

const experience = await getLocalizedEntries('experience', locale);
const featuredExperience = experience
  .filter((entry) => entry.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 4);

const featuredProjects = await mergeProjects(
  projectSeeds.filter((project) => project.featured),
  import.meta.env.GITHUB_TOKEN
);

const posts = await getLocalizedEntries('blog', locale);
const latestPosts = posts
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const whatsappHref = getWhatsAppHref(site.whatsapp.number, site.whatsapp.message);
---

<BaseLayout title={t(locale, 'hero.title')} description={t(locale, 'hero.tagline')} jsonLd="person">
  <Hero />

  <section class="section" data-reveal aria-labelledby="about-summary-heading">
    <div class="section-header">
      <h2 id="about-summary-heading">{t(locale, 'about.heading')}</h2>
      <a href={getRelativeLocaleUrl(locale, 'about')} class="nav-link">{t(locale, 'about.readMore')} →</a>
    </div>
    <div class="about-intro-grid">
      <div class="prose">
        <p>{t(locale, 'about.summaryP1')}</p>
        <p>{t(locale, 'about.summaryP2')}</p>
      </div>
      <figure class="about-photo-frame">
        <Image src={photoPlaceholder} alt={t(locale, 'about.photoAlt')} width={480} height={600} />
      </figure>
    </div>
  </section>

  <TwoWorlds />

  <section class="section" data-reveal aria-labelledby="featured-experience-heading">
    <div class="section-header">
      <h2 id="featured-experience-heading">{t(locale, 'experience.featuredHeading')}</h2>
      <a href={getRelativeLocaleUrl(locale, 'experience')} class="nav-link">{t(locale, 'experience.viewAll')} →</a>
    </div>
    <ExperienceCounter />
    <Timeline entries={featuredExperience} locale={locale} />
  </section>

  <section class="section" data-reveal aria-labelledby="featured-projects-heading">
    <div class="section-header">
      <h2 id="featured-projects-heading">{t(locale, 'projects.heading')}</h2>
      <a href={getRelativeLocaleUrl(locale, 'projects')} class="nav-link">{t(locale, 'projects.viewAll')} →</a>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} locale={locale} />)}
    </div>
  </section>

  <section class="section" data-reveal aria-labelledby="latest-posts-heading">
    <div class="section-header">
      <h2 id="latest-posts-heading">{t(locale, 'blog.latestHeading')}</h2>
      <a href={getRelativeLocaleUrl(locale, 'blog')} class="nav-link">{t(locale, 'blog.viewAll')} →</a>
    </div>
    <div class="blog-grid">
      {latestPosts.map((post) => <BlogCard entry={post} locale={locale} />)}
    </div>
  </section>

  <section class="section" data-reveal aria-labelledby="contact-heading">
    <div class="section-header">
      <h2 id="contact-heading">{t(locale, 'contact.heading')}</h2>
    </div>
    <div class="contact-actions">
      <a href={`mailto:${site.email}`} class="btn btn-lg">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="M3 7l9 6 9-6" />
        </svg>
        {t(locale, 'contact.emailCta')}
      </a>
      <a
        href={site.sameAs[0]}
        class="btn btn-lg btn-outline"
        target="_blank"
        rel="noreferrer noopener"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="6" cy="12" r="3" />
          <circle cx="18" cy="6" r="3" />
          <circle cx="18" cy="18" r="3" />
          <path d="M8.5 10.5l7-3M8.5 13.5l7 3" />
        </svg>
        {t(locale, 'contact.linkedinCta')}
      </a>
      {whatsappHref && (
        <a href={whatsappHref} class="btn btn-lg btn-outline" target="_blank" rel="noreferrer noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 3C6.9 3 3 6.6 3 11c0 2.1 1 4 2.6 5.4L4.8 21l4.3-1.6c.9.3 1.9.4 2.9.4 5.1 0 9-3.6 9-8S17.1 3 12 3Z" />
          </svg>
          {t(locale, 'contact.whatsappCta')}
        </a>
      )}
    </div>
  </section>
</BaseLayout>
