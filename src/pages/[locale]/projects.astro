---
// Full project grid (site-structure route list). GitHub live-data merge
// (design.md §6) runs once at build time via top-level await — never
// client-side.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { t, useLocale } from '../../i18n';
import { projects as projectSeeds } from '../../data/projects';
import { mergeProjects } from '../../lib/github';
import { getLocalizedEntries } from '../../lib/content-fallback';
import { getCollection } from 'astro:content';
import { localePath } from '../../lib/locale-path';

export function getStaticPaths() {
  return [
    { params: { locale: 'es' } },
    { params: { locale: 'en' } },
    { params: { locale: 'de' } },
    { params: { locale: 'fr' } },
    { params: { locale: 'ru' } },
  ];
}

const locale = useLocale(Astro.params.locale);

const projects = await mergeProjects(projectSeeds, import.meta.env.GITHUB_TOKEN);

// DeepWiki-style detail docs are opt-in per project (`content/projects/**`) —
// most seeds won't have one yet, so the card's internal link only renders
// when a matching entry exists for this locale (fallback chain included).
const detailEntries = await getLocalizedEntries('projects', locale);
const detailSlugByProjectId = new Map(
  detailEntries.map((entry) => [entry.data.projectId, entry.id.slice(entry.id.indexOf('/') + 1)]),
);

// Raw repo READMEs (not locale-specific: one entry per projectId), so each card
// can render its README collapsed and readable inline on this page. Absent for
// repos with an empty README ⇒ that card simply has no disclosure.
const readmeByProjectId = new Map((await getCollection('readmes')).map((entry) => [entry.id, entry]));
---

<BaseLayout title={t(locale, 'projects.heading')} description={t(locale, 'projects.metaDescription')} path="projects">
  <section class="section" data-reveal aria-labelledby="projects-heading">
    <h1 id="projects-heading" class="page-title">{t(locale, 'projects.heading')}</h1>
    <div class="project-grid">
      {
        projects.map((project, index) => {
          const detailSlug = detailSlugByProjectId.get(project.id);
          const detailHref = detailSlug ? localePath(locale, `projects/${detailSlug}`) : undefined;
          return (
            <ProjectCard
              project={project}
              locale={locale}
              index={index}
              headingLevel="h2"
              detailHref={detailHref}
              readmeEntry={readmeByProjectId.get(project.id)}
            />
          );
        })
      }
    </div>
  </section>
</BaseLayout>
