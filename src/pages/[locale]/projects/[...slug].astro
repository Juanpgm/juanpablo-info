---
// Project detail page (DeepWiki-style): PostLayout + reading time + rendered
// Markdown body, sourced from the `projects` content collection and
// cross-referenced against `data/projects.ts` (via `projectId`) for the
// repo URL and stack badges. Mirrors blog/[...slug].astro's per-locale
// static path generation so a real page exists at every /{locale}/projects/{slug}/
// even when the content is the ES fallback (no `en` doc yet).
import { getRelativeLocaleUrl } from 'astro:i18n';
import { render, type CollectionEntry } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import { t, useLocale, type Locale } from '../../../i18n';
import { getLocalizedEntries } from '../../../lib/content-fallback';
import { formatCalendarDate } from '../../../lib/format-date';
import { readingTimeMinutes } from '../../../lib/reading-time';
import { projects as projectSeeds } from '../../../data/projects';

interface Props {
  entry: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
  const locales: Locale[] = ['es', 'en', 'de', 'fr', 'ru'];
  const paths: { params: { locale: Locale; slug: string }; props: Props }[] = [];

  for (const locale of locales) {
    const entries = await getLocalizedEntries('projects', locale);
    for (const entry of entries.filter((e) => !e.data.draft)) {
      const slug = entry.id.slice(entry.id.indexOf('/') + 1);
      paths.push({ params: { locale, slug }, props: { entry } });
    }
  }

  return paths;
}

const locale = useLocale(Astro.params.locale);
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = entry.id.slice(entry.id.indexOf('/') + 1);
const seed = projectSeeds.find((p) => p.id === entry.data.projectId);
const minutes = readingTimeMinutes(entry.body ?? '');
const dateOptions: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
---

<PostLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`projects/${slug}`}
  readingTime={`${minutes} ${t(locale, 'blog.readingTimeSuffix')}`}
  tags={seed?.stack ?? []}
  jsonLd="article"
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  backHref={getRelativeLocaleUrl(locale, 'projects')}
  backLabel={t(locale, 'projects.backToIndex')}
>
  <TableOfContents slot="toc" headings={headings} label={t(locale, 'blog.tableOfContents')} />
  <Fragment slot="meta">
    {t(locale, 'blog.publishedOn')} {formatCalendarDate(entry.data.pubDate, locale, dateOptions)}
    {
      entry.data.updatedDate && (
        <>
          {' · '}
          {t(locale, 'blog.updatedOn')} {formatCalendarDate(entry.data.updatedDate, locale, dateOptions)}
        </>
      )
    }
    {
      seed?.repoUrl && (
        <>
          {' · '}
          <a href={seed.repoUrl} class="nav-link" target="_blank" rel="noreferrer noopener">
            {t(locale, 'projects.viewRepo')}
          </a>
        </>
      )
    }
  </Fragment>
  <Content />
</PostLayout>
