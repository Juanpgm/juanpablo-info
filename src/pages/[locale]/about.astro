---
// Full About (site-structure spec route list): narrative, education,
// certifications, languages (proposal §3.2).
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeCarousel from '../../components/CodeCarousel.astro';
import { t, useLocale } from '../../i18n';
import { education, certifications } from '../../data/education';
// PLACEHOLDER photo — real portrait pending, user-supplied (see
// src/assets/about-photo-placeholder.svg). Swap this import for the real
// file once provided; the two-column layout + duotone treatment below
// don't need to change.
import photoPlaceholder from '../../assets/about-photo-placeholder.svg';

export function getStaticPaths() {
  return [{ params: { locale: 'es' } }, { params: { locale: 'en' } }, { params: { locale: 'de' } }];
}

const locale = useLocale(Astro.params.locale);
const yearRange = (start: number, end?: number) => (end ? `${start}–${end}` : `${start}–${t(locale, 'experience.present')}`);
---

<BaseLayout title={t(locale, 'about.heading')} description={t(locale, 'about.summaryP1')} path="about" jsonLd="person">
  <section class="section" data-reveal aria-labelledby="about-heading">
    <h1 id="about-heading">{t(locale, 'about.heading')}</h1>
    <div class="about-intro-grid">
      <div class="prose">
        <p>{t(locale, 'about.summaryP1')}</p>
        <p>{t(locale, 'about.summaryP2')}</p>
        <p>{t(locale, 'about.narrativeP1')}</p>
        <p>{t(locale, 'about.narrativeP2')}</p>
        <p>{t(locale, 'about.narrativeP3')}</p>
      </div>
      <figure class="about-photo-frame">
        <Image src={photoPlaceholder} alt={t(locale, 'about.photoAlt')} width={480} height={600} />
      </figure>
    </div>
  </section>

  <section class="section" data-reveal aria-labelledby="code-snippet-heading">
    <div class="section-header">
      <h2 id="code-snippet-heading">{t(locale, 'about.codeSnippetHeading')}</h2>
    </div>
    <CodeCarousel locale={locale} />
  </section>

  <section class="section" data-reveal aria-labelledby="education-heading">
    <div class="section-header">
      <h2 id="education-heading">{t(locale, 'about.education')}</h2>
    </div>
    <ul class="definition-list">
      {
        education.map((entry) => (
          <li class="definition-list__item">
            <strong>{entry.institution}</strong> — {entry.program[locale]}
            <p class="definition-list__meta">
              {entry.location} · {yearRange(entry.startYear, entry.endYear)}
              {entry.note && <> · {entry.note[locale]}</>}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" data-reveal aria-labelledby="certifications-heading">
    <div class="section-header">
      <h2 id="certifications-heading">{t(locale, 'about.certifications')}</h2>
    </div>
    <ul class="definition-list">
      {
        certifications.map((cert) => (
          <li class="definition-list__item">
            <strong>{cert.name[locale]}</strong>
            <p class="definition-list__meta">
              {cert.issuer} · {cert.year}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" data-reveal aria-labelledby="languages-heading">
    <div class="section-header">
      <h2 id="languages-heading">{t(locale, 'about.languages')}</h2>
    </div>
    <ul class="definition-list">
      <li class="definition-list__item">{t(locale, 'about.language.es')}</li>
      <li class="definition-list__item">{t(locale, 'about.language.en')}</li>
      <li class="definition-list__item">{t(locale, 'about.language.de')}</li>
    </ul>
  </section>
</BaseLayout>
