---
// Rotating showcase of 4 REAL, byte-faithful excerpts from the author's own
// public GitHub repos (src/data/code-samples.ts) — replaces the single
// fabricated "illustrative, not runnable" placeholder from MVP launch.
//
// All 4 panels are always in the DOM (a11y/no-JS/SEO — nothing hidden behind
// JS-only rendering). The <script> below is what turns the stacked panels
// into a one-at-a-time carousel; without it every snippet stays visible and
// the nav controls stay hidden (progressive enhancement, matches
// TagFilter.astro's pattern of real elements that just do nothing pre-JS).
//
// Highlighting reuses the exact dual light/dark Shiki themes configured for
// markdown in astro.config.mjs (`themes: { light: 'github-light', dark:
// 'github-dark' }, defaultColor: false`) via Astro's built-in <Code>
// component, so panels render identically to the blog's markdown code
// blocks (see the "Shiki dual-theme code blocks" override in global.css).
import { Code } from 'astro:components';
import { t } from '../i18n';
import type { Locale } from '../i18n';
import { codeSamples } from '../data/code-samples';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const shikiThemes = { light: 'github-light', dark: 'github-dark' } as const;
---

<div class="code-carousel" data-code-carousel data-reveal>
  <p class="code-carousel__label">
    <span class="badge badge-example">Python</span>
    {t(locale, 'about.codeSnippetLabel')}
  </p>

  <div class="code-carousel__panels" data-carousel-panels>
    {
      codeSamples.map((sample, i) => (
        <article
          class:list={['code-carousel__panel', { 'is-active': i === 0 }]}
          role="tabpanel"
          id={`code-panel-${sample.id}`}
          aria-labelledby={`code-tab-${sample.id}`}
          data-carousel-panel
        >
          <header class="code-carousel__panel-header">
            <h3 class="code-carousel__project-name">{sample.projectName}</h3>
            <a href={sample.repoUrl} class="nav-link" target="_blank" rel="noreferrer noopener">
              {t(locale, 'projects.viewRepo')}
            </a>
          </header>
          <p class="code-carousel__caption">{sample.caption[locale]}</p>
          <Code code={sample.code} lang={sample.language} themes={shikiThemes} defaultColor={false} wrap />
        </article>
      ))
    }
  </div>

  <div class="code-carousel__nav" data-carousel-nav hidden>
    <button type="button" class="code-carousel__arrow" data-carousel-prev aria-label={t(locale, 'about.codeCarouselPrev')}>
      <span aria-hidden="true">‹</span>
    </button>
    <div class="code-carousel__tablist" role="tablist" aria-label={t(locale, 'about.codeCarouselTablistLabel')}>
      {
        codeSamples.map((sample, i) => (
          <button
            type="button"
            role="tab"
            id={`code-tab-${sample.id}`}
            aria-controls={`code-panel-${sample.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="code-carousel__tab"
            data-carousel-tab
            data-announce={`${t(locale, 'about.codeCarouselGoTo')} ${sample.projectName}`}
            aria-label={`${t(locale, 'about.codeCarouselGoTo')} ${sample.projectName}`}
          />
        ))
      }
    </div>
    <button type="button" class="code-carousel__arrow" data-carousel-next aria-label={t(locale, 'about.codeCarouselNext')}>
      <span aria-hidden="true">›</span>
    </button>
  </div>

  {/* Visually-hidden status region: only updated on user-initiated navigation
     (click/keyboard), never on the automatic ~7s tick — a low-frequency
     auto-rotating carousel that announced every auto-advance would be
     unusably noisy for screen-reader users (established a11y carousel
     pattern: mute the live region during autoplay). */}
  <div class="sr-only" role="status" aria-live="polite" data-carousel-status></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-code-carousel]');

  if (root) {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-panel]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-tab]'));
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const nav = root.querySelector<HTMLElement>('[data-carousel-nav]');
    const status = root.querySelector<HTMLElement>('[data-carousel-status]');
    const AUTO_ADVANCE_MS = 7000;

    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function render(nextIndex: number, announce: boolean) {
      index = ((nextIndex % panels.length) + panels.length) % panels.length;
      panels.forEach((panel, i) => panel.classList.toggle('is-active', i === index));
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      if (announce && status) {
        status.textContent = tabs[index]?.dataset.announce ?? '';
      }
    }

    function stopTimer() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    function startTimer() {
      stopTimer();
      // Real, meaningful check (not decorative): prefers-reduced-motion also
      // neutralizes CSS transitions globally (see global.css), but the
      // auto-advance *interval itself* is JS behavior — it must be skipped
      // here, or reduced-motion users would still get content changing
      // under them every ~7s with no CSS guard able to stop it.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = setInterval(() => render(index + 1, false), AUTO_ADVANCE_MS);
    }

    function goTo(nextIndex: number) {
      render(nextIndex, true);
      startTimer();
    }

    prevBtn?.addEventListener('click', () => goTo(index - 1));
    nextBtn?.addEventListener('click', () => goTo(index + 1));

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => goTo(i));
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          goTo(i + 1);
          tabs[index]?.focus();
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          goTo(i - 1);
          tabs[index]?.focus();
        }
      });
    });

    // Pause auto-advance on hover/focus (mouse + keyboard users) — cheap,
    // standard mitigation for WCAG 2.2.2 (auto-updating content needs a
    // pause mechanism); the prev/next/tab controls double as resume triggers.
    root.addEventListener('mouseenter', stopTimer);
    root.addEventListener('mouseleave', startTimer);
    root.addEventListener('focusin', stopTimer);
    root.addEventListener('focusout', startTimer);

    root.dataset.carouselReady = '';
    if (nav) nav.hidden = false;
    render(0, false);
    startTimer();
  }
</script>
