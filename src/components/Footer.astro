---
import LanguageSelector from './LanguageSelector.astro';
import { site } from '../data/site';
import { t, useLocale } from '../i18n';

const locale = useLocale(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-contact">
      <a href={`mailto:${site.email}`} class="nav-link" aria-label={t(locale, 'footer.emailLabel')}>
        {site.email}
      </a>
      <a
        href={site.sameAs[0]}
        class="nav-link"
        rel="noreferrer noopener"
        target="_blank"
        aria-label={t(locale, 'footer.linkedinLabel')}
      >
        LinkedIn
      </a>
      <span class="footer-location">{t(locale, 'footer.location')}</span>
    </div>

    <LanguageSelector />

    <p class="footer-copy">© {year} {site.name} · {t(locale, 'footer.rights')}</p>
  </div>
</footer>
