---
import LanguageSelector from './LanguageSelector.astro';
import { site } from '../data/site';

// Same scope note as Header.astro — literal labels here, real i18n dict lands
// in Phase 3.
const FOOTER_LABELS: Record<string, { location: string; rights: string }> = {
  es: { location: 'Cali, Valle del Cauca, Colombia', rights: 'Todos los derechos reservados.' },
  en: { location: 'Cali, Valle del Cauca, Colombia', rights: 'All rights reserved.' },
  de: { location: 'Cali, Valle del Cauca, Kolumbien', rights: 'Alle Rechte vorbehalten.' },
};

const locale = Astro.currentLocale ?? 'es';
const labels = FOOTER_LABELS[locale] ?? FOOTER_LABELS.es;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-contact">
      <a href={`mailto:${site.email}`} class="nav-link">{site.email}</a>
      <a href={site.sameAs[0]} class="nav-link" rel="noreferrer noopener" target="_blank">LinkedIn</a>
      <span class="footer-location">{labels.location}</span>
    </div>

    <LanguageSelector />

    <p class="footer-copy">© {year} {site.name} · {labels.rights}</p>
  </div>
</footer>
