---
// Home hero (2026-08-10 visual redesign; stripped to essentials, real photo
// 2026-08-11): full-bleed diagonal accent block bleeding from the top edge,
// and a centered name+portrait+CTA block — the section's only content.
// Eyebrow, location line, and the skills marquee were removed: the marquee
// duplicated skill labels already shown in the TwoWorlds section further
// down this same home page, and eyebrow/location added no CTA-adjacent
// value once the tagline was already gone (proposal.md §4.1 follow-up).
// Portrait: same astro:assets pattern as the About page's `.about-photo-frame`
// (an ASCII-art rendering was tried and dropped in favor of the real photo).
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ContactModal from './ContactModal.astro';
import { t, useLocale } from '../i18n';
import profilePhoto from '../assets/profile-photo.jpg';

const locale = useLocale(Astro.currentLocale);
---

<section class="hero" data-reveal aria-labelledby="hero-title">
  <div class="hero-block" aria-hidden="true"></div>
  <div class="hero-content">
    <div class="hero-identity">
      <h1 id="hero-title" class="hero-title">{t(locale, 'hero.title')}</h1>
      <div class="hero-photo-frame">
        <Image
          src={profilePhoto}
          alt={t(locale, 'about.photoAlt')}
          width={320}
          height={320}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="hero-actions">
      <a href={getRelativeLocaleUrl(locale, 'experience')} class="btn btn-lg">
        {t(locale, 'hero.ctaExperience')}
      </a>
      <button type="button" class="btn btn-lg btn-outline" data-open-contact-modal>
        {t(locale, 'hero.ctaContact')}
      </button>
    </div>
  </div>
</section>

<ContactModal locale={locale} />
