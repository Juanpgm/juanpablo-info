---
// Home hero (proposal.md §4.1, design §3). Confident display typography
// (Fraunces via h1), the mandatory "puentes entre..." hook, and the two
// primary CTAs (Ver experiencia / Descargar CV) + location.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, useLocale } from '../i18n';
import { cvHref } from '../lib/cv';

const locale = useLocale(Astro.currentLocale);
---

<section class="hero" data-reveal aria-labelledby="hero-title">
  <canvas class="hero-network" aria-hidden="true"></canvas>
  <p class="hero-eyebrow">{t(locale, 'hero.subtitle')}</p>
  <h1 id="hero-title" class="hero-title">{t(locale, 'hero.title')}</h1>
  <p class="hero-tagline">{t(locale, 'hero.tagline')}</p>
  <div class="hero-actions">
    <a href={getRelativeLocaleUrl(locale, 'experience')} class="btn btn-lg">
      {t(locale, 'hero.ctaExperience')}
    </a>
    <a
      href={cvHref(locale)}
      download
      class="btn btn-lg btn-outline"
      aria-label={t(locale, 'hero.ctaCvAriaLabel')}
    >
      {t(locale, 'hero.ctaCv')}
    </a>
    <span class="hero-location">{t(locale, 'hero.location')}</span>
  </div>
</section>

<script>
  // Decorative network background (lib/network-canvas.ts) — re-init per View
  // Transition navigation, torn down on the way out so no stray rAF loop
  // keeps animating a detached canvas from a previous visit to Home.
  import { initNetworkCanvas } from '../lib/network-canvas';

  let cleanup: (() => void) | undefined;

  function setup() {
    cleanup?.();
    cleanup = undefined;
    const canvas = document.querySelector<HTMLCanvasElement>('.hero-network');
    if (canvas) cleanup = initNetworkCanvas(canvas);
  }

  setup();
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
