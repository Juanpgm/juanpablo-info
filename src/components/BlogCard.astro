---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import { t } from '../i18n';
import type { Locale, UIKey } from '../i18n';
import { formatCalendarDate } from '../lib/format-date';
import type { BlogPostView } from '../lib/blog-view';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
  /** Heading level for the card title — must match the page's heading hierarchy
   * at the call site (h2 directly under an h1 page heading like /blog/, h3 when
   * nested under an h2 section heading like the home page's "latest posts"). */
  headingLevel?: 'h2' | 'h3';
  /** 0-based position in the listing — drives the oversized index numeral
   * (2026-08-10 visual redesign). Must match the array index the caller
   * maps over. */
  index: number;
  /** Slug/reading-time/hero-SVG, resolved once by the caller via
   * lib/blog-view.ts (not re-derived per card). */
  view: BlogPostView;
}

const { entry, locale, headingLevel = 'h3', index, view } = Astro.props;
const href = getRelativeLocaleUrl(locale, `blog/${view.slug}`);
const Heading = headingLevel;
---

<article class="blog-card" data-reveal data-tags={entry.data.tags.join(' ')}>
  <div class="listing-numeral" aria-hidden="true">
    <span class="listing-numeral__ghost">{String(index + 2).padStart(2, '0')}</span>
    <span class="listing-numeral__index">{String(index + 1).padStart(2, '0')}</span>
  </div>
  <div class="listing-content">
    {view.heroSvg && (
      <div class="blog-card__image" role="img" aria-label={entry.data.heroImageAlt} set:html={view.heroSvg} />
    )}
    <p class="blog-card__meta">
      <time datetime={entry.data.pubDate.toISOString()}>{formatCalendarDate(entry.data.pubDate, locale, { year: 'numeric', month: 'long' })}</time>
      <span aria-hidden="true"> · </span>
      {view.minutes} {t(locale, 'blog.readingTimeSuffix')}
    </p>
    <Heading class="blog-card__title">
      <a href={href}>{entry.data.title}</a>
    </Heading>
    <p class="blog-card__description">{entry.data.description}</p>
    <ul class="blog-card__tags">
      {entry.data.tags.map((tag) => <li class="badge badge-tag">{t(locale, `blog.tag.${tag}` as UIKey)}</li>)}
    </ul>
    <a href={href} class="nav-link">{t(locale, 'blog.readMore')} →</a>
  </div>
</article>
