---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import { t } from '../i18n';
import type { Locale, UIKey } from '../i18n';
import { readingTimeMinutes } from '../lib/reading-time';
import { formatCalendarDate } from '../lib/format-date';
import { resolveHeroDiagramKey } from '../lib/hero-diagram';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
  /** Heading level for the card title — must match the page's heading hierarchy
   * at the call site (h2 directly under an h1 page heading like /blog/, h3 when
   * nested under an h2 section heading like the home page's "latest posts"). */
  headingLevel?: 'h2' | 'h3';
}

const { entry, locale, headingLevel = 'h3' } = Astro.props;
// entry.id is "{locale}/{slug}" (design.md §4) — the route only needs slug.
const slug = entry.id.slice(entry.id.indexOf('/') + 1);
const href = getRelativeLocaleUrl(locale, `blog/${slug}`);
const minutes = readingTimeMinutes(entry.body ?? '');
const Heading = headingLevel;

// Inline SVG hero diagram — same pattern as PostLayout.astro (design.md
// "Inline SVG via ?raw glob + set:html").
const heroDiagrams = import.meta.glob('/src/assets/blog/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<
  string,
  string
>;
const heroDiagram = entry.data.heroImage ? heroDiagrams[resolveHeroDiagramKey(entry.id, slug)] : undefined;
---

<article class="blog-card" data-reveal data-tags={entry.data.tags.join(' ')}>
  {heroDiagram && (
    <div class="blog-card__image" role="img" aria-label={entry.data.heroImageAlt} set:html={heroDiagram} />
  )}
  <p class="blog-card__meta">
    <time datetime={entry.data.pubDate.toISOString()}>{formatCalendarDate(entry.data.pubDate, locale, { year: 'numeric', month: 'long' })}</time>
    <span aria-hidden="true"> · </span>
    {minutes} {t(locale, 'blog.readingTimeSuffix')}
  </p>
  <Heading class="blog-card__title">
    <a href={href}>{entry.data.title}</a>
  </Heading>
  <p class="blog-card__description">{entry.data.description}</p>
  <ul class="blog-card__tags">
    {entry.data.tags.map((tag) => <li class="badge badge-tag">{t(locale, `blog.tag.${tag}` as UIKey)}</li>)}
  </ul>
  <a href={href} class="nav-link">{t(locale, 'blog.readMore')} →</a>
</article>
