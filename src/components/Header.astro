---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSelector from './LanguageSelector.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, useLocale } from '../i18n';
import { nav } from '../data/nav';

const locale = useLocale(Astro.currentLocale);
const currentPath = Astro.url.pathname;

const navItems = nav.map((item) => ({
  href: getRelativeLocaleUrl(locale, item.route),
  label: t(locale, item.labelKey),
}));

// TODO(Phase 6, tasks 6.1-6.3): replace with lib/cv.ts `cvHref()` + real
// user-supplied PDFs at public/cv/. de falls back to en (no DE CV, design §9).
const cvLocale = locale === 'de' ? 'en' : locale;
const cvHref = `/cv/juan-pablo-guzman-${cvLocale}.pdf`;
---

<header class="site-header" id="site-header" data-scrolled="false">
  <div class="site-header__inner">
    <a href={getRelativeLocaleUrl(locale, '')} class="brand">JPGM</a>

    <nav aria-label="Primary" class="primary-nav">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LanguageSelector />
      <ThemeToggle />
      <a href={cvHref} download class="btn btn-cv" aria-label={t(locale, 'header.cvAriaLabel')}>
        {t(locale, 'header.cv')}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');

  function onScroll() {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
  }

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', onScroll);
</script>
