---
// Contact modal (post-launch fast-follow, replaces the old bottom-of-page
// Home Contact section). Native <dialog> per design §7 ADR A1 (vanilla JS
// only, no framework) — showModal()/close() give ESC-to-close, backdrop
// semantics, and focus-trap/focus-return for free. Opened from any
// [data-open-contact-modal] trigger; currently only Hero's "Contactar"
// button. Button markup below is copied as-is from the removed Home Contact
// section, just relocated.
import { site } from '../data/site';
import { getWhatsAppHref } from '../lib/whatsapp';
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const whatsappHref = getWhatsAppHref(site.whatsapp.number, site.whatsapp.message);
---

<dialog id="contact-modal" aria-labelledby="contact-modal-heading">
  <div class="contact-modal__header">
    <h2 id="contact-modal-heading">{t(locale, 'contact.heading')}</h2>
    <button
      type="button"
      class="btn-icon"
      data-close-contact-modal
      aria-label={t(locale, 'contact.closeCta')}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <form id="contact-form" class="contact-form" data-locale={locale} novalidate>
    <div class="contact-form__field">
      <label for="contact-name">{t(locale, 'contact.formNameLabel')}</label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        maxlength="200"
        autocomplete="name"
        aria-describedby="contact-name-error"
      />
      <p class="contact-form__field-error" id="contact-name-error" hidden>{t(locale, 'contact.fieldErrorName')}</p>
    </div>
    <div class="contact-form__field">
      <label for="contact-email">{t(locale, 'contact.formEmailLabel')}</label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        autocomplete="email"
        aria-describedby="contact-email-error"
      />
      <p class="contact-form__field-error" id="contact-email-error" hidden>{t(locale, 'contact.fieldErrorEmail')}</p>
    </div>
    <div class="contact-form__field">
      <label for="contact-message">{t(locale, 'contact.formMessageLabel')}</label>
      <textarea
        id="contact-message"
        name="message"
        required
        minlength="10"
        maxlength="5000"
        rows="4"
        aria-describedby="contact-message-error"></textarea>
      <p class="contact-form__field-error" id="contact-message-error" hidden>{t(locale, 'contact.fieldErrorMessage')}</p>
    </div>

    <div class="contact-form__field">
      <label for="contact-files">{t(locale, 'contact.formFilesLabel')}</label>
      <input
        type="file"
        id="contact-files"
        name="files"
        accept="image/*,.pdf,.doc,.docx"
        multiple
        data-remove-file-label={t(locale, 'contact.removeFileLabel')}
      />
      <ul class="contact-form__file-list" data-file-list></ul>
      <p class="contact-form__hint">{t(locale, 'contact.formFilesHint')}</p>
    </div>

    {/* Honeypot: invisible to sighted users and to assistive tech, but still
        present in the DOM/markup for a bot's naive autofill to catch. A
        human never sees or tabs into this field. */}
    <div class="visually-hidden">
      <label for="contact-website">Leave this field blank</label>
      <input
        type="text"
        id="contact-website"
        name="website"
        tabindex="-1"
        aria-hidden="true"
        autocomplete="off"
      />
    </div>

    <button
      type="submit"
      class="btn btn-lg contact-form__submit"
      data-idle-label={t(locale, 'contact.formSubmit')}
      data-pending-label={t(locale, 'contact.formSubmitPending')}
    >
      {t(locale, 'contact.formSubmit')}
    </button>

    <p
      class="contact-form__status"
      role="status"
      aria-live="polite"
      hidden
      data-error-message={t(locale, 'contact.formError')}
      data-files-invalid-message={t(locale, 'contact.formFilesInvalid')}
    ></p>
  </form>

  {/* Success state (replaces the form, not just an inline line) — shown
      briefly after a successful submit, then the dialog auto-closes so the
      user lands back on the page underneath having clearly registered "this
      worked". Sibling of <form>, toggled via `hidden` in initContactForm. */}
  <div class="contact-form__success" role="status" aria-live="polite" hidden>
    <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10" />
      <path d="M8 12.5l2.5 2.5L16 9.5" />
    </svg>
    <p class="contact-form__success-heading">{t(locale, 'contact.formSuccessHeading')}</p>
    <p class="contact-form__success-text">{t(locale, 'contact.formSuccess')}</p>
  </div>

  {/* Email/LinkedIn buttons removed (redundant with Footer's own icon
      links) — the form above is the primary contact path now. WhatsApp
      stays as the one situational secondary channel, only when configured
      (site.whatsapp.number), so the divider only renders alongside it. */}
  {whatsappHref && (
    <>
      <p class="contact-modal__divider">{t(locale, 'contact.otherChannels')}</p>
      <div class="contact-actions">
        <a href={whatsappHref} class="btn btn-lg btn-outline" target="_blank" rel="noreferrer noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 3C6.9 3 3 6.6 3 11c0 2.1 1 4 2.6 5.4L4.8 21l4.3-1.6c.9.3 1.9.4 2.9.4 5.1 0 9-3.6 9-8S17.1 3 12 3Z" />
          </svg>
          {t(locale, 'contact.whatsappCta')}
        </a>
      </div>
    </>
  )}
</dialog>

<script>
  import { validateAttachments, validateContactSubmission } from '../lib/contact-form';
  import type { ContactFieldError } from '../lib/contact-form';

  // View-Transition-safe wiring (same astro:page-load re-init pattern as
  // Header.astro/ThemeToggle.astro): re-queries the DOM and re-attaches
  // listeners on every navigation, since script modules only execute once
  // and dialog/trigger nodes aren't `transition:persist`ed.
  function initContactModal() {
    const dialog = document.getElementById('contact-modal');
    if (!(dialog instanceof HTMLDialogElement)) return;

    document.querySelectorAll('[data-open-contact-modal]').forEach((trigger) => {
      trigger.addEventListener('click', () => dialog.showModal());
    });

    dialog.querySelector('[data-close-contact-modal]')?.addEventListener('click', () => dialog.close());

    // A click that lands directly on the <dialog> (not a descendant) is a
    // click on its ::backdrop — native <dialog> has no other way to detect it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  // How long the success state stays visible before the dialog auto-closes
  // (returns the user to the page underneath). Long enough to read a short
  // confirmation, short enough not to feel stuck.
  const CLOSE_DELAY_MS = 2000;

  // Vanilla-JS submit handler (ADR A1 — no framework). Submits real
  // multipart/form-data (not JSON — the file input needs it) to
  // /api/contact, shows a pending state, then either a distinct success
  // state (swaps out the form, auto-closes the dialog) or an inline error
  // message read from the server's { ok } response — no alert(), no reload.
  function initContactForm() {
    const form = document.getElementById('contact-form');
    const dialog = document.getElementById('contact-modal');
    if (!(form instanceof HTMLFormElement) || !(dialog instanceof HTMLDialogElement)) return;
    // Re-init guard: astro:page-load can fire again for the same persisted
    // DOM node in some navigation cases; avoid double-binding the listener.
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const rawSubmitButton = form.querySelector('.contact-form__submit');
    const rawStatus = form.querySelector('.contact-form__status');
    const rawSuccessBlock = dialog.querySelector('.contact-form__success');
    const rawFileInput = form.querySelector('#contact-files');
    const rawFileList = form.querySelector('[data-file-list]');
    const rawNameInput = form.querySelector('#contact-name');
    const rawEmailInput = form.querySelector('#contact-email');
    const rawMessageInput = form.querySelector('#contact-message');
    if (
      !(rawSubmitButton instanceof HTMLButtonElement) ||
      !(rawStatus instanceof HTMLElement) ||
      !(rawSuccessBlock instanceof HTMLElement) ||
      !(rawFileInput instanceof HTMLInputElement) ||
      !(rawFileList instanceof HTMLElement) ||
      !(rawNameInput instanceof HTMLInputElement) ||
      !(rawEmailInput instanceof HTMLInputElement) ||
      !(rawMessageInput instanceof HTMLTextAreaElement)
    ) {
      return;
    }
    // Re-bound to explicitly typed consts: TS's control-flow narrowing from
    // the `instanceof` guard above doesn't survive into the nested closures
    // below (they may run long after this guard, e.g. on a later `submit`
    // event), so it would otherwise widen back to `Element | null` there.
    const submitButton: HTMLButtonElement = rawSubmitButton;
    const status: HTMLElement = rawStatus;
    const successBlock: HTMLElement = rawSuccessBlock;
    const fileInput: HTMLInputElement = rawFileInput;
    const fileList: HTMLElement = rawFileList;
    const nameInput: HTMLInputElement = rawNameInput;
    const emailInput: HTMLInputElement = rawEmailInput;
    const messageInput: HTMLTextAreaElement = rawMessageInput;

    const idleLabel = submitButton.dataset.idleLabel ?? submitButton.textContent ?? '';
    const pendingLabel = submitButton.dataset.pendingLabel ?? idleLabel;
    const errorMessage = status.dataset.errorMessage ?? '';
    const filesInvalidMessage = status.dataset.filesInvalidMessage ?? errorMessage;
    const removeFileLabel = fileInput.dataset.removeFileLabel ?? 'Remove';

    function showError(message: string) {
      status.textContent = message;
      status.classList.add('contact-form__status--error');
      status.hidden = false;
    }

    // One input + one pre-localized <p class="contact-form__field-error">
    // per validated field (see ContactModal's markup above) — the paragraph
    // already holds its generic translated message, so showing/hiding it is
    // all the script needs to do per field.
    // Partial: 'form' (structural errors, see contact-form.ts) has no input
    // to attach to — showFieldErrors/clearFieldErrors below must guard for
    // that rather than assume every ContactFieldError maps to a real field.
    const fieldInputs: Partial<Record<ContactFieldError['field'], HTMLInputElement | HTMLTextAreaElement>> = {
      name: nameInput,
      email: emailInput,
      message: messageInput,
    };

    function clearFieldErrors() {
      (Object.keys(fieldInputs) as ContactFieldError['field'][]).forEach((field) => {
        const input = fieldInputs[field];
        if (!input) return;
        input.removeAttribute('aria-invalid');
        const errorEl = document.getElementById(`${input.id}-error`);
        if (errorEl) errorEl.hidden = true;
      });
    }

    function showFieldErrors(errors: ContactFieldError[]) {
      errors.forEach(({ field }) => {
        const input = fieldInputs[field];
        if (!input) return;
        input.setAttribute('aria-invalid', 'true');
        const errorEl = document.getElementById(`${input.id}-error`);
        if (errorEl) errorEl.hidden = false;
      });
    }

    // Feature-detected once: DataTransfer is the only platform-native way to
    // mutate an <input type="file">'s otherwise-read-only FileList, but it's
    // not guaranteed everywhere. If it's unavailable, still list the
    // selected files (useful on its own) but skip offering a remove button
    // that would silently no-op instead of doing something broken.
    const supportsDataTransfer = typeof DataTransfer !== 'undefined';

    function formatFileSize(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      const kb = bytes / 1024;
      if (kb < 1024) return `${kb.toFixed(1)} KB`;
      return `${(kb / 1024).toFixed(1)} MB`;
    }

    function removeFileAt(index: number) {
      try {
        const dt = new DataTransfer();
        Array.from(fileInput.files ?? []).forEach((file, i) => {
          if (i !== index) dt.items.add(file);
        });
        fileInput.files = dt.files;
      } catch {
        return; // Leave the selection untouched rather than half-mutate it.
      }
      // The button the user just activated is about to be removed from the
      // DOM (renderFileList rebuilds the whole list) — without this, focus
      // would silently drop to <body>, stranding keyboard/screen-reader
      // users. Land on whatever now occupies the same slot; the list
      // shifted up by one, so the same index is the next item, or the
      // previous one if this was the last row, or the file input itself
      // once the list is empty.
      const remaining = fileInput.files?.length ?? 0;
      const nextFocusIndex = remaining === 0 ? null : Math.min(index, remaining - 1);
      renderFileList();
      if (nextFocusIndex === null) {
        fileInput.focus();
      } else {
        fileList.querySelectorAll<HTMLButtonElement>('.contact-form__file-remove')[nextFocusIndex]?.focus();
      }
    }

    function renderFileList() {
      fileList.innerHTML = '';
      Array.from(fileInput.files ?? []).forEach((file, index) => {
        const item = document.createElement('li');
        item.className = 'contact-form__file-item';

        const label = document.createElement('span');
        label.textContent = `${file.name} — ${formatFileSize(file.size)}`;
        item.append(label);

        if (supportsDataTransfer) {
          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.className = 'contact-form__file-remove';
          removeButton.setAttribute('aria-label', removeFileLabel);
          removeButton.textContent = '×';
          removeButton.addEventListener('click', () => removeFileAt(index));
          item.append(removeButton);
        }

        fileList.append(item);
      });
    }

    fileInput.addEventListener('change', renderFileList);

    // Reopening the modal (or closing it after any outcome) should never
    // show stale success/error state or a previous submission's leftover
    // input — a single `close` listener covers every close path (X button,
    // backdrop click, ESC, or our own auto-close on success).
    dialog.addEventListener('close', () => {
      form.reset();
      form.hidden = false;
      successBlock.hidden = true;
      status.hidden = true;
      status.classList.remove('contact-form__status--error');
      clearFieldErrors();
      renderFileList();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      status.hidden = true;
      status.classList.remove('contact-form__status--error');
      clearFieldErrors();

      // Per-field pre-flight check, using the same pure validator the server
      // re-runs — this is UX only, never a substitute for the server's own
      // re-validation.
      const fieldsCheck = validateContactSubmission({
        name: nameInput.value,
        email: emailInput.value,
        message: messageInput.value,
      });
      if (!fieldsCheck.valid) {
        showFieldErrors(fieldsCheck.errors);
        return;
      }

      // Client-side pre-flight check, using the same pure validator the
      // server re-runs — this is UX only (avoids a slow/wasted upload for an
      // obviously invalid selection), never a substitute for the server's
      // own re-validation.
      const files = Array.from(fileInput.files ?? []);
      const attachmentsCheck = validateAttachments(
        files.map((file) => ({ name: file.name, size: file.size, type: file.type }))
      );
      if (!attachmentsCheck.valid) {
        showError(filesInvalidMessage);
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = pendingLabel;

      // FormData(form) already picks up every named field, including the
      // file input's actual files (multipart encoding, set automatically by
      // fetch from the FormData body) — `locale` isn't a real form field, so
      // it's appended manually from the dataset set by Astro.
      const formData = new FormData(form);
      formData.append('locale', form.dataset.locale ?? 'es');

      try {
        const response = await fetch('/api/contact', { method: 'POST', body: formData });
        const result = await response.json().catch(() => ({ ok: false }));

        if (response.ok && result.ok) {
          form.hidden = true;
          successBlock.hidden = false;
          window.setTimeout(() => dialog.close(), CLOSE_DELAY_MS);
        } else {
          showError(errorMessage);
        }
      } catch {
        showError(errorMessage);
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = idleLabel;
      }
    });
  }

  initContactModal();
  initContactForm();
  document.addEventListener('astro:page-load', () => {
    initContactModal();
    initContactForm();
  });
</script>
