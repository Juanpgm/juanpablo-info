---
// Contact modal (post-launch fast-follow, replaces the old bottom-of-page
// Home Contact section). Native <dialog> per design §7 ADR A1 (vanilla JS
// only, no framework) — showModal()/close() give ESC-to-close, backdrop
// semantics, and focus-trap/focus-return for free. Opened from any
// [data-open-contact-modal] trigger; currently only Hero's "Contactar"
// button. Button markup below is copied as-is from the removed Home Contact
// section, just relocated.
import { site } from '../data/site';
import { getWhatsAppHref } from '../lib/whatsapp';
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const whatsappHref = getWhatsAppHref(site.whatsapp.number, site.whatsapp.message);
---

<dialog id="contact-modal" aria-labelledby="contact-modal-heading">
  <div class="contact-modal__header">
    <h2 id="contact-modal-heading">{t(locale, 'contact.heading')}</h2>
    <button
      type="button"
      class="btn-icon"
      data-close-contact-modal
      aria-label={t(locale, 'contact.closeCta')}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <div class="contact-actions">
    <a href={`mailto:${site.email}`} class="btn btn-lg">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 7l9 6 9-6" />
      </svg>
      {t(locale, 'contact.emailCta')}
    </a>
    <a
      href={site.sameAs[0]}
      class="btn btn-lg btn-outline"
      target="_blank"
      rel="noreferrer noopener"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="6" r="3" />
        <circle cx="18" cy="18" r="3" />
        <path d="M8.5 10.5l7-3M8.5 13.5l7 3" />
      </svg>
      {t(locale, 'contact.linkedinCta')}
    </a>
    {whatsappHref && (
      <a href={whatsappHref} class="btn btn-lg btn-outline" target="_blank" rel="noreferrer noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3C6.9 3 3 6.6 3 11c0 2.1 1 4 2.6 5.4L4.8 21l4.3-1.6c.9.3 1.9.4 2.9.4 5.1 0 9-3.6 9-8S17.1 3 12 3Z" />
        </svg>
        {t(locale, 'contact.whatsappCta')}
      </a>
    )}
  </div>
</dialog>

<script>
  // View-Transition-safe wiring (same astro:page-load re-init pattern as
  // Header.astro/ThemeToggle.astro): re-queries the DOM and re-attaches
  // listeners on every navigation, since script modules only execute once
  // and dialog/trigger nodes aren't `transition:persist`ed.
  function initContactModal() {
    const dialog = document.getElementById('contact-modal');
    if (!(dialog instanceof HTMLDialogElement)) return;

    document.querySelectorAll('[data-open-contact-modal]').forEach((trigger) => {
      trigger.addEventListener('click', () => dialog.showModal());
    });

    dialog.querySelector('[data-close-contact-modal]')?.addEventListener('click', () => dialog.close());

    // A click that lands directly on the <dialog> (not a descendant) is a
    // click on its ::backdrop — native <dialog> has no other way to detect it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  initContactModal();
  document.addEventListener('astro:page-load', initContactModal);
</script>
