---
// Contact modal (post-launch fast-follow, replaces the old bottom-of-page
// Home Contact section). Native <dialog> per design §7 ADR A1 (vanilla JS
// only, no framework) — showModal()/close() give ESC-to-close, backdrop
// semantics, and focus-trap/focus-return for free. Opened from any
// [data-open-contact-modal] trigger; currently only Hero's "Contactar"
// button. Button markup below is copied as-is from the removed Home Contact
// section, just relocated.
import { site } from '../data/site';
import { getWhatsAppHref } from '../lib/whatsapp';
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const whatsappHref = getWhatsAppHref(site.whatsapp.number, site.whatsapp.message);
---

<dialog id="contact-modal" aria-labelledby="contact-modal-heading">
  <div class="contact-modal__header">
    <h2 id="contact-modal-heading">{t(locale, 'contact.heading')}</h2>
    <button
      type="button"
      class="btn-icon"
      data-close-contact-modal
      aria-label={t(locale, 'contact.closeCta')}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <form id="contact-form" class="contact-form" data-locale={locale} novalidate>
    <div class="contact-form__field">
      <label for="contact-name">{t(locale, 'contact.formNameLabel')}</label>
      <input type="text" id="contact-name" name="name" required maxlength="200" autocomplete="name" />
    </div>
    <div class="contact-form__field">
      <label for="contact-email">{t(locale, 'contact.formEmailLabel')}</label>
      <input type="email" id="contact-email" name="email" required autocomplete="email" />
    </div>
    <div class="contact-form__field">
      <label for="contact-message">{t(locale, 'contact.formMessageLabel')}</label>
      <textarea id="contact-message" name="message" required minlength="10" maxlength="5000" rows="4"></textarea>
    </div>

    {/* Honeypot: invisible to sighted users and to assistive tech, but still
        present in the DOM/markup for a bot's naive autofill to catch. A
        human never sees or tabs into this field. */}
    <div class="visually-hidden">
      <label for="contact-website">Leave this field blank</label>
      <input
        type="text"
        id="contact-website"
        name="website"
        tabindex="-1"
        aria-hidden="true"
        autocomplete="off"
      />
    </div>

    <button
      type="submit"
      class="btn btn-lg contact-form__submit"
      data-idle-label={t(locale, 'contact.formSubmit')}
      data-pending-label={t(locale, 'contact.formSubmitPending')}
    >
      {t(locale, 'contact.formSubmit')}
    </button>

    <p
      class="contact-form__status"
      role="status"
      aria-live="polite"
      hidden
      data-success-message={t(locale, 'contact.formSuccess')}
      data-error-message={t(locale, 'contact.formError')}
    ></p>
  </form>

  <p class="contact-modal__divider">{t(locale, 'contact.otherChannels')}</p>

  <div class="contact-actions">
    <a href={`mailto:${site.email}`} class="btn btn-lg btn-outline">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 7l9 6 9-6" />
      </svg>
      {t(locale, 'contact.emailCta')}
    </a>
    <a
      href={site.sameAs[0]}
      class="btn btn-lg btn-outline"
      target="_blank"
      rel="noreferrer noopener"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="6" r="3" />
        <circle cx="18" cy="18" r="3" />
        <path d="M8.5 10.5l7-3M8.5 13.5l7 3" />
      </svg>
      {t(locale, 'contact.linkedinCta')}
    </a>
    {whatsappHref && (
      <a href={whatsappHref} class="btn btn-lg btn-outline" target="_blank" rel="noreferrer noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3C6.9 3 3 6.6 3 11c0 2.1 1 4 2.6 5.4L4.8 21l4.3-1.6c.9.3 1.9.4 2.9.4 5.1 0 9-3.6 9-8S17.1 3 12 3Z" />
        </svg>
        {t(locale, 'contact.whatsappCta')}
      </a>
    )}
  </div>
</dialog>

<script>
  // View-Transition-safe wiring (same astro:page-load re-init pattern as
  // Header.astro/ThemeToggle.astro): re-queries the DOM and re-attaches
  // listeners on every navigation, since script modules only execute once
  // and dialog/trigger nodes aren't `transition:persist`ed.
  function initContactModal() {
    const dialog = document.getElementById('contact-modal');
    if (!(dialog instanceof HTMLDialogElement)) return;

    document.querySelectorAll('[data-open-contact-modal]').forEach((trigger) => {
      trigger.addEventListener('click', () => dialog.showModal());
    });

    dialog.querySelector('[data-close-contact-modal]')?.addEventListener('click', () => dialog.close());

    // A click that lands directly on the <dialog> (not a descendant) is a
    // click on its ::backdrop — native <dialog> has no other way to detect it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  // Vanilla-JS submit handler (ADR A1 — no framework). POSTs JSON to
  // /api/contact, shows a pending state, then an inline success/error
  // message read from the server's { ok } response — no alert(), no reload.
  function initContactForm() {
    const form = document.getElementById('contact-form');
    if (!(form instanceof HTMLFormElement)) return;
    // Re-init guard: astro:page-load can fire again for the same persisted
    // DOM node in some navigation cases; avoid double-binding the listener.
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const submitButton = form.querySelector('.contact-form__submit');
    const status = form.querySelector('.contact-form__status');
    if (!(submitButton instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;

    const idleLabel = submitButton.dataset.idleLabel ?? submitButton.textContent ?? '';
    const pendingLabel = submitButton.dataset.pendingLabel ?? idleLabel;
    const successMessage = status.dataset.successMessage ?? '';
    const errorMessage = status.dataset.errorMessage ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      submitButton.disabled = true;
      submitButton.textContent = pendingLabel;
      status.hidden = true;
      status.classList.remove('contact-form__status--success', 'contact-form__status--error');

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get('name') ?? ''),
        email: String(formData.get('email') ?? ''),
        message: String(formData.get('message') ?? ''),
        website: String(formData.get('website') ?? ''),
        locale: form.dataset.locale ?? 'es',
      };

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({ ok: false }));

        if (response.ok && result.ok) {
          form.reset();
          status.textContent = successMessage;
          status.classList.add('contact-form__status--success');
        } else {
          status.textContent = errorMessage;
          status.classList.add('contact-form__status--error');
        }
      } catch {
        status.textContent = errorMessage;
        status.classList.add('contact-form__status--error');
      } finally {
        status.hidden = false;
        submitButton.disabled = false;
        submitButton.textContent = idleLabel;
      }
    });
  }

  initContactModal();
  initContactForm();
  document.addEventListener('astro:page-load', () => {
    initContactModal();
    initContactForm();
  });
</script>
