---
// No-flash theme init lives in BaseLayout's <head> (inline, runs before first
// paint on every navigation via `astro:after-swap`). This component only owns
// the toggle button; `transition:persist` keeps the same DOM node (and its
// listener) across View Transitions instead of a fresh one being swapped in.
//
// aria-label reflects the action the button performs next (accessibility
// pass, task 4.4) — computed client-side since the visitor's current theme
// isn't known at build/SSR time.
import { t, useLocale } from '../i18n';

const locale = useLocale(Astro.currentLocale);
const labelToDark = t(locale, 'header.themeToggleAriaLabelToDark');
const labelToLight = t(locale, 'header.themeToggleAriaLabelToLight');
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle btn-icon"
  aria-label={labelToDark}
  data-label-to-dark={labelToDark}
  data-label-to-light={labelToLight}
  transition:persist
>
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" />
  </svg>
</button>

<script>
  const button = document.getElementById('theme-toggle');

  function syncLabel() {
    if (!(button instanceof HTMLElement)) return;
    const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    const nextLabel = current === 'dark' ? button.dataset.labelToLight : button.dataset.labelToDark;
    if (nextLabel) button.setAttribute('aria-label', nextLabel);
  }

  button?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    syncLabel();
  });

  syncLabel();
  document.addEventListener('astro:after-swap', syncLabel);
</script>
