---
// Renders the 'recent' experience group as TimelineCard[]. The first (most
// recent) card starts expanded, matching the wireframe (proposal §4.2).
import type { CollectionEntry } from 'astro:content';
import TimelineCard from './TimelineCard.astro';
import type { Locale } from '../i18n';

interface Props {
  entries: CollectionEntry<'experience'>[];
  locale: Locale;
  /** Forwarded to TimelineCard — must match the page's heading hierarchy at
   * the call site (see TimelineCard's own prop doc). */
  headingLevel?: 'h2' | 'h3';
}

const { entries, locale, headingLevel = 'h3' } = Astro.props;
---

<ol class="timeline">
  {
    entries.map((entry, index) => (
      <li>
        <TimelineCard entry={entry} locale={locale} open={index === 0} headingLevel={headingLevel} />
      </li>
    ))
  }
</ol>
