---
// One experience role — native <details>/<summary> for zero-JS expand,
// keyboard + screen-reader accessible for free (design §7). NO image slot:
// the `experience` schema has no `image` field (design §4/§10, locks
// proposal O7 — Teatrino renders as a plain text entry, same as every role).
import type { CollectionEntry } from 'astro:content';
import { t } from '../i18n';
import type { Locale } from '../i18n';
import { formatCalendarDate, formatCalendarDuration, getCalendarDuration, getCalendarYear } from '../lib/format-date';

interface Props {
  entry: CollectionEntry<'experience'>;
  locale: Locale;
  open?: boolean;
  /** Heading level for the company/role title — must match the page's heading
   * hierarchy at the call site (h2 directly under an h1 page heading like
   * /experience/, h3 when nested under an h2 section heading like the home
   * page's "featured experience"). */
  headingLevel?: 'h2' | 'h3';
}

const { entry, locale, open = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const { company, role, location, startDate, endDate, current, highlights, stack } = entry.data;

const dateOptions: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short' };
const startLabel = formatCalendarDate(startDate, locale, dateOptions);
const endLabel = current || !endDate ? t(locale, 'experience.present') : formatCalendarDate(endDate, locale, dateOptions);
const durationWords = {
  year: t(locale, 'experience.year'),
  years: t(locale, 'experience.years'),
  month: t(locale, 'experience.month'),
  months: t(locale, 'experience.months'),
  connector: t(locale, 'experience.counterConnector'),
};
const duration = formatCalendarDuration(getCalendarDuration(startDate, endDate ?? new Date()), durationWords);
---

<details class="timeline-card" open={open}>
  <summary class="timeline-card__summary">
    <Heading class="timeline-card__heading">
      <strong>{company}</strong>
      <span class="timeline-card__role">{role}</span>
    </Heading>
    <span class="timeline-card__year">{getCalendarYear(startDate)}</span>
    {current && <span class="badge badge-current">{t(locale, 'experience.current')}</span>}
  </summary>
  <div class="timeline-card__body">
    <p class="timeline-card__meta">{startLabel} – {endLabel} · {duration} · {location}</p>
    <ul class="timeline-card__highlights">
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
    {
      stack.length > 0 && (
        <p class="timeline-card__stack">
          <span class="timeline-card__stack-label">{t(locale, 'experience.stackLabel')}:</span>
          {stack.map((tech) => <span class="badge badge-stack">{tech}</span>)}
        </p>
      )
    }
  </div>
</details>
