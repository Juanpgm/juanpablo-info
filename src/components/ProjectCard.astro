---
// Stack badges + star/lang/updated slots. Live GitHub enrichment is Phase 5
// (`lib/github.ts`) — for now every seed renders from `data/projects.ts`
// as-is with its `isExample` badge; the optional `stars`/`primaryLanguage`/
// `lastUpdated`/`stale` props are accepted now so Phase 5 only has to pass
// data, not touch this template.
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { t } from '../i18n';
import type { Locale } from '../i18n';
import type { ProjectSeed } from '../data/projects';

interface Props {
  project: ProjectSeed & {
    stars?: number | null;
    primaryLanguage?: string | null;
    lastUpdated?: string | null;
    // `stale` is still supplied by lib/github.ts on a failed live fetch, but
    // it's no longer surfaced as a visible badge (user feedback: added no
    // value, overflowed the card header) — the card just quietly omits the
    // live-meta row instead (see hasLiveMeta below).
    stale?: boolean;
  };
  locale: Locale;
  /** Heading level for the card title — must match the page's heading hierarchy
   * at the call site (h2 directly under an h1 page heading like /projects/, h3
   * when nested under an h2 section heading like the home page's "featured
   * projects"). */
  headingLevel?: 'h2' | 'h3';
  /** 0-based position in the listing — drives the oversized index numeral
   * (2026-08-10 visual redesign). Must match the array index the caller
   * maps over. */
  index: number;
  /** Site-relative URL of the DeepWiki-style detail page, when one exists
   * for this project + locale (content/projects/** is opt-in per project —
   * most seeds won't have a doc yet). Omitted entirely otherwise. */
  detailHref?: string;
  /** Raw repo README entry (`readmes` collection). When present, the card
   * renders a collapsed disclosure so the README can be read inline on the
   * listing page — no navigation. Omitted (e.g. home page) ⇒ no disclosure. */
  readmeEntry?: CollectionEntry<'readmes'>;
}

const { project, locale, headingLevel = 'h3', index, detailHref, readmeEntry } = Astro.props;
const hasLiveMeta = project.primaryLanguage != null || project.lastUpdated != null;
const Heading = headingLevel;
const ReadmeContent = readmeEntry ? (await render(readmeEntry)).Content : null;
---

<article class="project-card" data-reveal>
  <div class="listing-numeral" aria-hidden="true">
    <span class="listing-numeral__ghost">{String(index + 2).padStart(2, '0')}</span>
    <span class="listing-numeral__index">{String(index + 1).padStart(2, '0')}</span>
  </div>
  <div class="listing-content">
    {
      project.image && (
        <Image
          src={project.image}
          alt={`${project.name} – ${t(locale, 'projects.screenshotAlt')}`}
          width={640}
          class="project-card__image"
          loading="lazy"
        />
      )
    }
    <header class="project-card__header">
      <Heading class="project-card__title">{project.name}</Heading>
      {project.isExample && <span class="badge badge-example">{t(locale, 'projects.exampleBadge')}</span>}
    </header>

    <p class="project-card__description">{project.description[locale]}</p>

    <ul class="project-card__stack">
      {project.stack.map((tech) => <li class="badge badge-stack">{tech}</li>)}
    </ul>

    {
      hasLiveMeta && (
        <p class="project-card__meta">
          {project.primaryLanguage && <span>{project.primaryLanguage}</span>}
          {project.lastUpdated && (
            <time datetime={project.lastUpdated}>{new Date(project.lastUpdated).toLocaleDateString(locale)}</time>
          )}
        </p>
      )
    }

    {
      (detailHref || project.repoUrl || project.liveUrl) && (
        <p class="project-card__links">
          {detailHref && (
            <a href={detailHref} class="nav-link">
              {t(locale, 'projects.viewDetails')}
            </a>
          )}
          {project.repoUrl && (
            <a href={project.repoUrl} class="nav-link" target="_blank" rel="noreferrer noopener">
              {t(locale, 'projects.viewRepo')}
            </a>
          )}
          {project.liveUrl && (
            <a href={project.liveUrl} class="nav-link" target="_blank" rel="noreferrer noopener">
              {t(locale, 'projects.viewLive')}
            </a>
          )}
        </p>
      )
    }

    {
      ReadmeContent && (
        <details class="project-card__readme">
          <summary>{t(locale, 'projects.readmeToggle')}</summary>
          <div class="post-content project-card__readme-body">
            <ReadmeContent />
          </div>
        </details>
      )
    }
  </div>
</article>

<style>
  .project-card__readme {
    margin-top: 1.25rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .project-card__readme > summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--accent-ink);
    list-style-position: inside;
  }
  .project-card__readme > summary:hover {
    color: var(--accent-hover);
  }
  .project-card__readme-body {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    background: var(--surface-subtle);
    border-radius: 0.5rem;
    overflow-x: auto;
  }
</style>
