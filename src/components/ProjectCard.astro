---
// Stack badges + star/lang/updated slots. Live GitHub enrichment is Phase 5
// (`lib/github.ts`) — for now every seed renders from `data/projects.ts`
// as-is with its `isExample` badge; the optional `stars`/`primaryLanguage`/
// `lastUpdated`/`stale` props are accepted now so Phase 5 only has to pass
// data, not touch this template.
import { t } from '../i18n';
import type { Locale } from '../i18n';
import type { ProjectSeed } from '../data/projects';

interface Props {
  project: ProjectSeed & {
    stars?: number | null;
    primaryLanguage?: string | null;
    lastUpdated?: string | null;
    stale?: boolean;
  };
  locale: Locale;
  /** Heading level for the card title — must match the page's heading hierarchy
   * at the call site (h2 directly under an h1 page heading like /projects/, h3
   * when nested under an h2 section heading like the home page's "featured
   * projects"). */
  headingLevel?: 'h2' | 'h3';
}

const { project, locale, headingLevel = 'h3' } = Astro.props;
const hasLiveMeta = project.stars != null || project.primaryLanguage != null || project.lastUpdated != null;
const Heading = headingLevel;
---

<article class="project-card" data-reveal>
  <header class="project-card__header">
    <Heading>{project.name}</Heading>
    {project.isExample && <span class="badge badge-example">{t(locale, 'projects.exampleBadge')}</span>}
    {!project.isExample && project.stale && <span class="badge badge-stale">{t(locale, 'projects.staleBadge')}</span>}
  </header>

  <p class="project-card__description">{project.description[locale]}</p>

  <ul class="project-card__stack">
    {project.stack.map((tech) => <li class="badge badge-stack">{tech}</li>)}
  </ul>

  {
    hasLiveMeta && (
      <p class="project-card__meta">
        {project.stars != null && <span>★ {project.stars}</span>}
        {project.primaryLanguage && <span>{project.primaryLanguage}</span>}
        {project.lastUpdated && (
          <time datetime={project.lastUpdated}>{new Date(project.lastUpdated).toLocaleDateString(locale)}</time>
        )}
      </p>
    )
  }

  {
    project.repoUrl && (
      <a href={project.repoUrl} class="nav-link" target="_blank" rel="noreferrer noopener">
        {t(locale, 'projects.viewRepo')}
      </a>
    )
  }
</article>
