---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Hreflang from './Hreflang.astro';
import { site } from '../../data/site';

interface Props {
  title: string;
  description: string;
  // Logical page path with no locale prefix, e.g. '' (home), 'about'.
  path?: string;
  // 'person' emits the Person JSON-LD (design §8) — Home + About only.
  // Every other page emits a minimal WebPage/WebSite schema instead.
  jsonLd?: 'person' | 'webpage';
  // OG image, site-relative path. Defaults to the single pre-rendered
  // branded PNG (design A8 — no per-post dynamic OG pipeline at launch).
  // ponytail: if per-post OG images become desirable, generate them at
  // build time (satori/resvg) inside each getStaticPaths and pass a
  // per-post path here instead of widening this default.
  ogImage?: string;
}

const { title, description, path = '', jsonLd = 'webpage', ogImage = '/og/default.png' } = Astro.props;
const locale = Astro.currentLocale ?? 'es';
const canonical = getAbsoluteLocaleUrl(locale, path);
const absoluteOgImage = new URL(ogImage, Astro.site).toString();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  email: `mailto:${site.email}`,
  url: Astro.site?.toString(),
  sameAs: site.sameAs,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  knowsLanguage: site.knowsLanguage,
  knowsAbout: site.knowsAbout,
};

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: site.name, url: Astro.site?.toString() },
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteOgImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={absoluteOgImage} />

<Hreflang path={path} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd === 'person' ? personJsonLd : webPageJsonLd)} />
