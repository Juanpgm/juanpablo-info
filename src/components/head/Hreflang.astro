---
import { LOCALES, localeUrlAbsolute } from '../../lib/locale-path';

interface Props {
  // Logical page path with no locale prefix, e.g. '' (home), 'about', 'blog/my-post'.
  path?: string;
}

const { path = '' } = Astro.props;
---

{LOCALES.map((locale) => <link rel="alternate" hreflang={locale} href={localeUrlAbsolute(Astro.site, locale, path)} />)}
<link rel="alternate" hreflang="x-default" href={localeUrlAbsolute(Astro.site, 'en', path)} />
