---
// Collapsed accordion for the 'early' experience group — compact, one line
// per role, closed by default (design §3/§7, proposal §4.2).
import type { CollectionEntry } from 'astro:content';
import { t } from '../i18n';
import type { Locale } from '../i18n';
import { formatCalendarDate } from '../lib/format-date';

interface Props {
  entries: CollectionEntry<'experience'>[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
---

<details class="early-experience">
  <summary class="early-experience__summary">{t(locale, 'experience.earlyLabel')}</summary>
  <ul class="early-experience__list">
    {
      entries.map((entry) => (
        <li class="early-experience__item">
          <span class="early-experience__year">{formatCalendarDate(entry.data.startDate, locale, { year: 'numeric' })}</span>
          <span class="early-experience__role">
            <strong>{entry.data.company}</strong> — {entry.data.role}
          </span>
          <span class="early-experience__note">{entry.data.highlights[0]}</span>
        </li>
      ))
    }
  </ul>
</details>
