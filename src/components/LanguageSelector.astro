---
// aria-label localized via i18n (task 4.4 fix — was hardcoded English before,
// leaving `header.languageSelectorLabel` unused). `context` disambiguates the
// two instances (Header + Footer both render this) so a screen-reader
// landmark list doesn't show two identically-named nav regions.
import { switchLocalePath, LOCALES } from '../lib/locale-path';
import { t, useLocale } from '../i18n';

interface Props {
  context?: string;
}

const { context } = Astro.props;
const locale = useLocale(Astro.currentLocale);
const currentPath = Astro.url.pathname;
const label = context ? `${t(locale, 'header.languageSelectorLabel')} (${context})` : t(locale, 'header.languageSelectorLabel');
---

<nav aria-label={label} class="lang-selector">
  {
    LOCALES.map((loc) => (
      <a
        href={switchLocalePath(currentPath, loc)}
        class="lang-link nav-link"
        aria-current={loc === locale ? 'true' : undefined}
        lang={loc}
      >
        {loc.toUpperCase()}
      </a>
    ))
  }
</nav>

<script>
  // Persist a manual language choice so a later bare "/" visit (see
  // src/pages/index.astro) honors it instead of re-running browser-language
  // auto-detection every time.
  function bindLangSelector() {
    document.querySelectorAll<HTMLAnchorElement>('.lang-selector .lang-link').forEach((link) => {
      if (link.dataset.bound) return;
      link.dataset.bound = 'true';
      link.addEventListener('click', () => {
        const locale = link.getAttribute('lang');
        if (locale) localStorage.setItem('locale', locale);
      });
    });
  }
  bindLangSelector();
  document.addEventListener('astro:page-load', bindLangSelector);
</script>
