---
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/head/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  // Logical page path with no locale prefix, e.g. '' (home), 'about'.
  path?: string;
  // 'person' (Home/About) vs 'article' (blog posts) vs 'webpage' (everything
  // else) JSON-LD — see SeoHead.
  jsonLd?: 'person' | 'webpage' | 'article';
  // Only meaningful when jsonLd === 'article' — forwarded to SeoHead as-is.
  pubDate?: Date;
  updatedDate?: Date;
  heroImageUrl?: string;
  // Per-post/per-locale OG image, site-relative path (e.g. `/og/es/{slug}.png`
  // — see `src/pages/og/[...slug].ts`). Forwarded to SeoHead as-is; SeoHead
  // falls back to `/og/default.png` when this is undefined (non-blog pages).
  ogImage?: string;
}

const { title, description, path = '', jsonLd = 'webpage', pubDate, updatedDate, heroImageUrl, ogImage } =
  Astro.props;
const locale = Astro.currentLocale ?? 'es';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      path={path}
      jsonLd={jsonLd}
      pubDate={pubDate}
      updatedDate={updatedDate}
      heroImageUrl={heroImageUrl}
      ogImage={ogImage}
    />
    <ClientRouter />

    <!--
      No-flash theme init (design §8). Reads localStorage.theme, falling back
      to matchMedia. Runs synchronously before first paint, and again on
      `astro:after-swap` so View Transition navigations don't flash the
      wrong theme before ThemeToggle's persisted button state re-applies.
    -->
    <script is:inline>
      (function () {
        // Local-time default (2026-08-10 visual redesign) replaces the old
        // matchMedia('(prefers-color-scheme: dark)') fallback — 7:00-19:00
        // local device time reads as light, otherwise dark.
        // localStorage.theme (set by ThemeToggle.astro) still wins whenever
        // present — only the *unset* default changed. No running interval:
        // this only re-evaluates on page load / astro:after-swap, so a tab
        // left open across the 7:00/19:00 boundary won't flip live —
        // acceptable for a portfolio site.
        function defaultThemeForLocalTime() {
          var hour = new Date().getHours();
          return hour >= 7 && hour < 19 ? 'light' : 'dark';
        }
        function applyTheme() {
          var stored = localStorage.getItem('theme');
          var theme = stored || defaultThemeForLocalTime();
          document.documentElement.dataset.theme = theme;
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <!--
      No-JS fallback: `[data-reveal]` sections/cards start invisible
      (opacity/transform) until lib/scroll-reveal.ts reveals them on
      IntersectionObserver. Without JS that script never runs, so force full
      visibility here instead of leaving content permanently hidden.
    -->
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import { initScrollReveal } from '../lib/scroll-reveal';
      const run = () => initScrollReveal();
      run();
      document.addEventListener('astro:page-load', run);
    </script>
  </body>
</html>
