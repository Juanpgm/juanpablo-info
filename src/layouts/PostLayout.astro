---
// Article chrome: TOC slot, reading time, prev/next, back-to-index link
// (Phase 3, task 3.8) wired from the blog post page.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  readingTime?: string;
  prev?: { href: string; label: string } | null;
  next?: { href: string; label: string } | null;
  backHref?: string;
  backLabel?: string;
}

const { title, description, path, readingTime, prev = null, next = null, backHref, backLabel } = Astro.props;
---

<BaseLayout title={title} description={description} path={path}>
  <article class="post" data-reveal>
    <header class="post-header">
      {backHref && backLabel && (
        <a href={backHref} class="nav-link post-back-link">← {backLabel}</a>
      )}
      <h1>{title}</h1>
      {readingTime && <p class="post-meta">{readingTime}</p>}
    </header>

    <div class="post-body">
      <aside class="post-toc" aria-label="Table of contents">
        <slot name="toc" />
      </aside>
      <div class="post-content">
        <slot />
      </div>
    </div>

    <nav class="post-pagination" aria-label="Post navigation">
      {prev && (
        <a href={prev.href} rel="prev" class="nav-link">
          ← {prev.label}
        </a>
      )}
      {next && (
        <a href={next.href} rel="next" class="nav-link">
          {next.label} →
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
