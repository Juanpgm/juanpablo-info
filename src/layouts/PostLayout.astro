---
// Article chrome: TOC slot, reading time, prev/next, back-to-index link
// (Phase 3, task 3.8) wired from the blog post page. `tags`/`heroImage`
// added post-launch (fast-follow) — heroImage is optional/progressive, a
// post that doesn't set one renders nothing extra (no placeholder).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import AuthorByline from '../components/AuthorByline.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  readingTime?: string;
  tags?: string[];
  heroImage?: ImageMetadata;
  prev?: { href: string; label: string } | null;
  next?: { href: string; label: string } | null;
  backHref?: string;
  backLabel?: string;
  // BlogPosting JSON-LD (post-launch fast-follow) — forwarded as-is to
  // BaseLayout/SeoHead. Pass jsonLd="article" from a blog post page only.
  jsonLd?: 'person' | 'webpage' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description,
  path,
  readingTime,
  tags = [],
  heroImage,
  prev = null,
  next = null,
  backHref,
  backLabel,
  jsonLd,
  pubDate,
  updatedDate,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  pubDate={pubDate}
  updatedDate={updatedDate}
  heroImageUrl={heroImage?.src}
>
  <article class="post" data-reveal>
    <header class="post-header">
      {backHref && backLabel && (
        <a href={backHref} class="nav-link post-back-link">← {backLabel}</a>
      )}
      <h1 class="page-title">{title}</h1>
      <p class="post-meta">
        <slot name="meta" />
        {readingTime && (
          <>
            <span aria-hidden="true"> · </span>
            {readingTime}
          </>
        )}
      </p>
      {tags.length > 0 && (
        <ul class="post-tags">
          {tags.map((tag) => <li class="badge badge-tag">{tag}</li>)}
        </ul>
      )}
      <AuthorByline />
    </header>

    {heroImage && <Image src={heroImage} alt="" width={1200} height={630} class="post-hero-image" />}

    <div class="post-body">
      <aside class="post-toc" aria-label="Table of contents">
        <slot name="toc" />
      </aside>
      <div class="post-content">
        <slot />
      </div>
    </div>

    <nav class="post-pagination" aria-label="Post navigation">
      {prev && (
        <a href={prev.href} rel="prev" class="nav-link">
          ← {prev.label}
        </a>
      )}
      {next && (
        <a href={next.href} rel="next" class="nav-link">
          {next.label} →
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
