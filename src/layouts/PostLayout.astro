---
// Article chrome: TOC slot, reading time, prev/next, back-to-index link
// (Phase 3, task 3.8) wired from the blog post page. `tags`/`heroImage`
// added post-launch (fast-follow) — heroImage is optional/progressive, a
// post that doesn't set one renders nothing extra (no placeholder).
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { resolveHeroDiagramKey } from '../lib/hero-diagram';

interface Props {
  title: string;
  description: string;
  path: string;
  readingTime?: string;
  tags?: string[];
  // Kept for BaseLayout/SeoHead's JSON-LD `image` (heroImageUrl) — the
  // *rendered* hero below is resolved independently, off entryId/slug, not
  // off this field's actual asset (design.md: "a missed repoint still
  // renders correctly").
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  heroImageCaption?: string;
  // entry.id ("{locale}/{slug}") — needed to pick the ES/EN diagram variant.
  entryId?: string;
  slug?: string;
  prev?: { href: string; label: string } | null;
  next?: { href: string; label: string } | null;
  backHref?: string;
  backLabel?: string;
  // BlogPosting JSON-LD (post-launch fast-follow) — forwarded as-is to
  // BaseLayout/SeoHead. Pass jsonLd="article" from a blog post page only.
  jsonLd?: 'person' | 'webpage' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description,
  path,
  readingTime,
  tags = [],
  heroImage,
  heroImageAlt,
  heroImageCaption,
  entryId,
  slug,
  prev = null,
  next = null,
  backHref,
  backLabel,
  jsonLd,
  pubDate,
  updatedDate,
} = Astro.props;

// Inline SVG hero diagram (design.md "Inline SVG via ?raw glob + set:html" —
// the only way var(--diagram-*) resolves against the page cascade so the
// diagram flips with data-theme; an external <Image> doc can't do that).
const heroDiagrams = import.meta.glob('/src/assets/blog/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<
  string,
  string
>;
const heroDiagram = heroImage && entryId && slug ? heroDiagrams[resolveHeroDiagramKey(entryId, slug)] : undefined;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  pubDate={pubDate}
  updatedDate={updatedDate}
  heroImageUrl={heroImage?.src}
>
  <article class="post" data-reveal>
    <header class="post-header">
      {backHref && backLabel && (
        <a href={backHref} class="nav-link post-back-link">← {backLabel}</a>
      )}
      <h1 class="page-title">{title}</h1>
      <p class="post-meta">
        <slot name="meta" />
        {readingTime && (
          <>
            <span aria-hidden="true"> · </span>
            {readingTime}
          </>
        )}
      </p>
      {tags.length > 0 && (
        <ul class="post-tags">
          {tags.map((tag) => <li class="badge badge-tag">{tag}</li>)}
        </ul>
      )}
      <AuthorByline />
    </header>

    {heroDiagram && (
      <figure class="post-hero">
        <div class="post-hero-image" role="img" aria-label={heroImageAlt} set:html={heroDiagram} />
        {heroImageCaption && <figcaption>{heroImageCaption}</figcaption>}
      </figure>
    )}

    <div class="post-body">
      <aside class="post-toc" aria-label="Table of contents">
        <slot name="toc" />
      </aside>
      <div class="post-content">
        <slot />
      </div>
    </div>

    <nav class="post-pagination" aria-label="Post navigation">
      {prev && (
        <a href={prev.href} rel="prev" class="nav-link">
          ← {prev.label}
        </a>
      )}
      {next && (
        <a href={next.href} rel="next" class="nav-link">
          {next.label} →
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
